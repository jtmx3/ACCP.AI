# SQLite file; keep the data/ directory private and outside version control.
ACCP_DB_PATH=data/accp.sqlite3

# Default is local deterministic rules; no external model requests are made.
MODEL_PROVIDER=rules

# Optional OpenAI-compatible provider. The UI reveals a per-question consent
# checkbox only after these values are configured. Never commit a real key.
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# MODEL_API_KEY=
# MODEL_TIMEOUT_SECONDS=15
