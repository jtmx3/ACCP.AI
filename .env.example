# SQLite file; keep the data/ directory private and outside version control.
ACCP_DB_PATH=data/accp.sqlite3

# Safe default: deterministic local rules; this does not call a model.
MODEL_PROVIDER=rules

# Optional local Ollama configuration. Change MODEL_PROVIDER to ollama only after
# installing the model locally and confirming `ollama list` shows this exact tag.
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=Jais-3-3.7B-GGUF:Q4_K_M
MODEL_TIMEOUT_SECONDS=120
OLLAMA_REASONING_EFFORT=none

# Adaptive question generation is separately opt-in and off by default.
ACCP_ADAPTIVE_MODEL_QUESTIONS=0
