# SQLite file; keep the data/ directory private and outside version control.
ACCP_DB_PATH=data/accp.sqlite3

# Default: local deterministic rules. No model requests are made in this mode.
MODEL_PROVIDER=rules

# Optional local Ollama. Install/pull the selected model separately, then use
# the exact tag returned by `ollama list`.
# MODEL_PROVIDER=ollama
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_NAME=qwen3:4b
# MODEL_TIMEOUT_SECONDS=120
# A local Ollama API key is not required; the adapter supplies a local placeholder.

# Optional remote OpenAI-compatible service. Consent is still required per request.
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=<model-id-supported-by-your-endpoint>
# MODEL_API_KEY=<never-commit-a-real-key>
# MODEL_TIMEOUT_SECONDS=60
# MODEL_REASONING_EFFORT=low
